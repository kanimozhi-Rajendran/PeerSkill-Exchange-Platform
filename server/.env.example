PORT=5000
NODE_ENV=development

# Database Configuration
# Provide your local or Atlas MongoDB URI. If MongoDB is offline or unavailable,
# the backend gracefully falls back to built-in persistent disk storage at server/data/db.json.
MONGODB_URI=mongodb://127.0.0.1:27017/peer_skill_exchange

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d

# Google OAuth 2.0 Credentials (Google Identity Services)
# Configure via Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized JavaScript origin: http://localhost:3000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Service URLs
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Credit & Economy System Rules
INITIAL_STUDENT_CREDITS=10
CREDITS_PER_COMPLETED_SESSION=5

# Default Administrator Credentials (for development seed)
ADMIN_EMAIL=admin@peerskill.edu
ADMIN_PASSWORD=Admin@123
