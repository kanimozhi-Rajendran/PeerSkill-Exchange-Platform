# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide your local or Atlas MongoDB URI. If MongoDB is not installed,
# the server automatically uses persistent local storage at server/data/db.json.
MONGODB_URI=mongodb://127.0.0.1:27017/peer_skill_exchange

# JWT Authentication
JWT_SECRET=peer_skill_exchange_super_secret_jwt_key_2026
JWT_EXPIRE=7d

# Google OAuth 2.0 Credentials
# Configure via Google Cloud Console (https://console.cloud.google.com/):
# 1. Create a project and configure OAuth Consent Screen.
# 2. Create Web Application Credentials.
# 3. Add Authorized JavaScript Origins: http://localhost:3000
# 4. Paste your Client ID below:
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Service URLs
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Initial System Settings
INITIAL_STUDENT_CREDITS=10
CREDITS_PER_COMPLETED_SESSION=5
ADMIN_EMAIL=admin@peerskill.edu
ADMIN_PASSWORD=Admin@123

